# Alternika QR Studio - Variables de Entorno

# Contraseña maestra del panel privado /qr (por defecto: Imbera2026$)
QR_ADMIN_PASSWORD=Imbera2026$

# Conexión a Supabase (opcional pero recomendada para guardar los datos en la nube)
# Obtén estas dos claves en: https://supabase.com -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://tu-proyecto.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=tu_clave_anonima_publica
